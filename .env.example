# --- Server Binding ---
# Mode terpadu (direkomendasikan untuk produksi): REST_PORT == WS_PORT,
# server melayani REST API di /api dan WebSocket di / & /ws pada satu port.
HOST_IP=127.0.0.1
REST_PORT=8081
WS_PORT=8080

# =========================================================================
# PostgreSQL / Supabase (WAJIB - dipakai runtime; untuk BUILD macro sqlx,
# lihat catatan SQLX_OFFLINE di bawah).
#
# Pada Supabase:
#   - port 5432 = session pooler (TERUJI: aman untuk sqlx runtime & query!)
#   - port 6543 = transaction pooler (TIDAK cocok untuk sqlx/prepare: memicu
#     `prepared statement "sqlx_s_*" already exists` -> query gagal acak)
#   - host db.<ref>.supabase.co = koneksi langsung (IPv6-only di proyek ini)
#
# Catatan building (macro query!):
#   * JANGAN build dengan DATABASE_URL menunjuk ke *pooler* Supabase - macro
#     sqlx akan gagal ("prepared statement sqlx_s_* already exists") karena
#     pooler memultipleks koneksi.
#   * Gunakan offline cache yang sudah tersedia di .sqlx/:
#       Linux  : SQLX_OFFLINE=true cargo build --release
#       Windows: $env:SQLX_OFFLINE="true"; cargo build --release
#   * Untuk regenerasi cache: cargo install sqlx-cli --no-default-features
#     --features postgres,rustls --version 0.7.4 ; lalu jalankan terhadap
#     PostgreSQL ASLI (bukan pooler): cargo sqlx prepare --workspace -- --all-targets
#
# Prasyarat build di Linux: reqwest memakai rustls -> aws-lc-rs -> aws-lc-sys
# yang mengompilasi C dan memanggil `cmake`.
#   sudo apt install -y build-essential cmake
# =========================================================================
DATABASE_URL=postgres://postgres.xzjxkplsgzcvdcjdhpcp:YOUR_DB_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# =========================================================================
# Verifikasi token
#
# HS256 - token yang diterbitkan backend sendiri lewat POST /api/auth/login.
#   Di-sign dengan SUPABASE_JWT_SECRET.
#
# ES256 - token dari supabase.auth.signInWithPassword, diverifikasi lewat
#   JWKS Supabase (kunci publik, tanpa shared secret). Backend memuat JWKS
#   saat startup lalu cache di memory; di-refresh otomatis tiap 1 jam atau
#   saat ditemukan kid baru.
#   Isi SUPABASE_URL, atau SUPABASE_JWKS_URL bila mau eksplisit. Kosongkan
#   keduanya untuk menonaktifkan verifikasi ES256.
#
# Wajib diisi di produksi, kalau tidak login Supabase akan 401.
# =========================================================================
SUPABASE_JWT_SECRET=isi_dengan_jwt_secret_supabase_anda
SUPABASE_URL=https://xzjxkplsgzcvdcjdhpcp.supabase.co
# SUPABASE_JWKS_URL=https://xzjxkplsgzcvdcjdhpcp.supabase.co/auth/v1/.well-known/jwks.json

# =========================================================================
