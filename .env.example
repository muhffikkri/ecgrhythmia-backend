VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh6anhrcGxzZ3pjdmRjamRocGNwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY2Mjg5MDUsImV4cCI6MjEwMjIwNDkwNX0.sSiDSjXZ4ntmBSmZIiRUfazzsXncpVRBMXINZGlsO1c
