  "query": "SELECT d.id AS \"id!\", d.account_id AS \"account_id!\", d.first_name || ' ' || d.last_name AS \"name!\", a.role AS \"role!\", COALESCE(a.status, 'Offline') AS \"status!\", a.created_at, a.profile_photo \n                 FROM doctors d JOIN accounts a ON d.account_id = a.id ORDER BY a.created_at DESC LIMIT $1 OFFSET $2",
