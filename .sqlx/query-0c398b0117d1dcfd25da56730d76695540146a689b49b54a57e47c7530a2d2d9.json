  "query": "SELECT s.id, s.device_id, s.patient_id, p.first_name || ' ' || p.last_name as patient_name, s.started_at, s.ended_at, s.file_path, s.ecg_paper \n             FROM sessions s LEFT JOIN patients p ON s.patient_id = p.id \n             ORDER BY s.started_at DESC LIMIT $1 OFFSET $2",
