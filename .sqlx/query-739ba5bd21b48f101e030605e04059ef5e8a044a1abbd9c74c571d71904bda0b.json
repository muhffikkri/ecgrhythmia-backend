  "query": "SELECT p.id AS \"id!\", p.account_id AS \"account_id!\", p.first_name || ' ' || p.last_name AS \"name!\", a.role AS \"role!\", COALESCE(a.status, 'Offline') AS \"status!\", a.created_at, p.primary_doctor_id, p.device_id, a.profile_photo \n                 FROM patients p JOIN accounts a ON p.account_id = a.id ORDER BY a.created_at DESC LIMIT $1 OFFSET $2",
