{
  "db_name": "PostgreSQL",
  "query": "SELECT s.id, s.device_id, s.patient_id, p.first_name || ' ' || p.last_name as patient_name, s.started_at, s.ended_at, s.file_path, s.ecg_paper \n             FROM sessions s JOIN patients p ON s.patient_id = p.id \n             WHERE p.primary_doctor_id = $1 ORDER BY s.started_at DESC LIMIT $2 OFFSET $3",
